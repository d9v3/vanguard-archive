{
  "permissions": {
    "allow": [
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path // empty' | { read -r f; case \"$f\" in *.rs) [ -f \"$f\" ] && rustfmt --edition 2024 \"$f\" ;; esac; } 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "rustfmt"
          }
        ]
      }
    ]
  }
}

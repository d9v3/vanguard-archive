[Unit]
Description=Gardien : mettre à jour la clé USB GARDIEN avec la dernière version de GitHub
# Au montage de la clé : récupère la dernière version de GitHub (si c'est sans risque), la compile si elle est
# nouvelle, puis copie tout sur la clé. Après une compilation faite ici, c'est gardien-copie.service qui copie.
After=run-media-%u-GARDIEN.mount network-online.target

[Service]
Type=oneshot
ExecStart=%h/Projects/gardien/outils/deployer.sh --branchement
# Une compilation complète (Linux + Windows, optimisée) peut prendre quelques minutes.
TimeoutStartSec=20min
Nice=10

[Install]
WantedBy=run-media-%u-GARDIEN.mount

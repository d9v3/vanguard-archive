[Unit]
Description=netscan : mettre à jour la clé USB NETSCAN
# Déclenché au montage de la clé (WantedBy) et par netscan-compilation.path après chaque compilation :
# --sans-compiler, sinon il recompile (environnement différent). Le .path part une fois par binaire écrit :
# deployer.sh attend la fin de cargo et ne notifie qu'une fois par version.
After=run-media-alice-NETSCAN.mount

[Service]
Type=oneshot
ExecStart=/home/alice/Projects/netscan/outils/deployer.sh --sans-compiler

[Install]
WantedBy=run-media-alice-NETSCAN.mount

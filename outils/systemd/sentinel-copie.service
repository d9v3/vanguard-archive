[Unit]
Description=sentinel : copier la dernière compilation sur la clé USB SENTINEL
# Déclenché par sentinel-compilation.path après chaque compilation : --sans-compiler, sinon il recompilerait
# (environnement différent). Le .path part une fois par binaire écrit : deployer.sh attend la fin de cargo et ne
# notifie qu'une fois par version.

[Service]
Type=oneshot
ExecStart=/home/alice/Projects/sentinel/outils/deployer.sh --sans-compiler
TimeoutStartSec=20min

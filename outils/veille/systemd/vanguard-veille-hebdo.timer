[Unit]
Description=Vanguard : relecture de sécurité hebdomadaire, le vendredi à 05 h 30

[Timer]
# Après la nuit du vendredi et le renouvellement du quota de la semaine (vendredi 3 h).
OnCalendar=Fri 05:30
# Manquée (ordinateur éteint) : faite au démarrage suivant ; une seule par semaine (budget dans commun.sh).
Persistent=true

[Install]
WantedBy=timers.target
